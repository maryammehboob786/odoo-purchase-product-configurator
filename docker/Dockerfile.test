# Odoo 19 image with Google Chrome, used only to run browser (tour) tests locally.
# (The official odoo:19.0 image is Ubuntu 24.04, where the apt "chromium" package is a snap stub.)
FROM odoo:19.0

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends wget ca-certificates fonts-liberation python3-websocket \
    && wget -q -O /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
    && apt-get install -y --no-install-recommends /tmp/chrome.deb \
    && rm -f /tmp/chrome.deb \
    && rm -rf /var/lib/apt/lists/*
USER odoo
